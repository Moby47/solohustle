APP_NAME="Solo Hustle"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://solohustle.test
APP_TIMEZONE=Africa/Lagos
# Namecheap only: absolute path to public_html. Leave empty everywhere else.
APP_PUBLIC_PATH=

# First admin account (created by: php artisan db:seed). Leave the password empty to have one generated and shown once.
ADMIN_EMAIL=admin@solohustle.test
ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=solohustle
DB_USERNAME=root
DB_PASSWORD=
# Heroku: JAWSDB_URL is used automatically when DB_URL is empty.
DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Uploads: media_local (public/uploads) or media_s3 (Cloudflare R2, for Heroku)
MEDIA_DISK=media_local
MEDIA_S3_KEY=
MEDIA_S3_SECRET=
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_URL=
